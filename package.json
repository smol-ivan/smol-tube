{
  "name": "smol-tube",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "clean": "pnpm -r run clean && rimraf node_modules",
    "dev:front": "pnpm --filter @smol-tube/frontend dev",
    "dev:back": "pnpm --filter @smol-tube/backend dev:socket",
    "dev": "pnpm --filter @smol-tube/frontend --filter @smol-tube/backend --parallel dev",
    "format:check": "pnpm --recursive --if-present format:check",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build": "pnpm --recursive --if-present build",
    "ci": "pnpm lint && pnpm test && pnpm build"
  },
  "author": "gordillosolis@icloud.com",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "devDependencies": {
    "rimraf": "^6.1.3"
  }
}
