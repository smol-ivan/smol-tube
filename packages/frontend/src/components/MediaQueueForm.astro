---
import { Icon } from "astro-icon/components";
interface Props {
    mediaPlaceholder: string;
}

const { mediaPlaceholder } = Astro.props;
---

<div class="flex gap-2">
    <div class="relative flex-1">
        <input
            data-media-input
            class="w-full bg-surface-container-low border border-outline-variant rounded font-label-md text-label-md pl-9 pr-3 py-1.5 focus:border-tertiary focus:ring-1 focus:ring-tertiary outline-none text-on-surface placeholder:text-on-surface-variant/50"
            placeholder={mediaPlaceholder}
            type="text"
        />
        <Icon
            name="lucide:search"
            class="absolute left-2.5 top-1.5 size-4 text-on-surface-variant/60 pointer-events-none"
        />
    </div>
    <button
        data-queue-next
        class="bg-surface-variant border border-outline-variant px-4 py-1.5 text-on-surface font-label-md text-label-md rounded hover:bg-surface-container-highest transition-colors whitespace-nowrap"
    >
        <Icon
            name="lucide:list-start"
            class="size-4 text-on-surface-variant group-hover:text-tertiary transition-colors"
        />
    </button>
    <button
        data-queue-last
        class="bg-surface-variant border border-outline-variant px-4 py-1.5 text-on-surface font-label-md text-label-md rounded hover:bg-surface-container-highest transition-colors whitespace-nowrap"
    >
        <Icon
            name="lucide:list-end"
            class="size-4 text-on-surface-variant group-hover:text-tertiary transition-colors"
        />
    </button>
</div>
