---
// ChatPanel.astro — sin props, todo lo maneja el JS
---

<div class="flex-1 flex flex-col overflow-hidden">
    <div
        class="h-8 px-panel-padding flex items-center border-b border-outline-variant bg-surface-container-low"
    >
        <span
            class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant"
        >
            <span class="material-symbols-outlined text-[14px] align-middle mr-1">chat</span>
            Chat
        </span>
    </div>
    <div
        data-chat-messages
        class="flex-1 overflow-y-auto p-panel-padding space-y-3 font-body-md text-body-md"
    >
        <!-- El JS renderiza aquí los mensajes -->
    </div>
    <div
        class="p-2 border-t border-outline-variant bg-surface-container flex flex-col gap-2"
    >
        <div class="flex gap-2">
            <input
                data-chat-input
                class="flex-1 bg-surface-container-low border border-outline-variant rounded font-body-md text-body-md px-3 py-1.5 focus:border-tertiary focus:ring-1 focus:ring-tertiary outline-none text-on-surface placeholder:text-on-surface-variant/50"
                placeholder="Escribe un mensaje..."
                type="text"
            />
            <button
                data-chat-send
                class="bg-secondary/20 border border-secondary px-3 py-1.5 text-secondary font-label-md text-label-md rounded hover:bg-secondary/30 transition-colors"
            >
                Enviar
            </button>
        </div>
        <div class="flex justify-between items-center">
            <button
                class="bg-surface-variant border border-outline-variant px-3 py-1 text-on-surface font-label-md text-label-md rounded hover:bg-surface-container-highest transition-colors"
            >
                Emotes
            </button>
            <button
                data-guest-login
                class="bg-surface-variant border border-outline-variant px-3 py-1 text-on-surface font-label-md text-label-md rounded hover:bg-surface-container-highest transition-colors"
            >
                Cambiar cuenta
            </button>
        </div>
    </div>
</div>
