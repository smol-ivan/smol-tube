---
// PlaylistPanel.astro — sin props estáticos, JS controla todo
import { Icon } from "astro-icon/components";
---

<aside
    class="playlist-panel border-t border-outline-variant bg-surface flex flex-col h-64 flex-shrink-0"
>
    <div
        class="h-8 px-panel-padding flex justify-between items-center border-b border-outline-variant bg-surface-container-low"
    >
        <!-- Lado Izquierdo: Icono + Título -->
        <div class="flex items-center text-on-surface-variant">
            <Icon name="lucide:list-music" class="size-4 mr-1.5" />
            <span class="font-label-sm text-label-sm uppercase tracking-widest">
                Playlist
            </span>
        </div>

        <!-- Lado Derecho: Contador e Información de Tiempo en la misma línea -->
        <div
            class="flex items-center gap-2 font-label-md text-label-md text-on-surface-variant"
        >
            <span data-playlist-count>0 items</span>
            <span class="text-outline-variant/60">•</span>
            <span data-playlist-duration class="font-mono">00:00</span>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto bg-surface-dim flex flex-col">
        <!-- History section -->
        <div
            id="playlist-history"
            class="hidden flex-col flex-shrink-0 border-b border-outline-variant bg-surface-container/50"
        >
            <div
                class="px-3 py-1 font-label-sm text-xs uppercase tracking-widest text-on-surface-variant/70 border-b border-outline-variant/50"
            >
                History
            </div>
            <div data-playlist-history-items class="flex flex-col"></div>
        </div>

        <!-- El JS renderiza los items aquí -->
        <div data-playlist-items class="flex flex-col flex-1">
            <div
                class="flex-1 flex items-center justify-center p-4 text-center font-label-md text-label-md text-on-surface-variant opacity-40 italic"
            >
                The playlist is empty
            </div>
        </div>
    </div>
</aside>
