---
// PlaylistPanel.astro — sin props estáticos, JS controla todo
---

<aside
    class="playlist-panel border-t border-outline-variant bg-surface flex flex-col h-64 flex-shrink-0"
>
    <div
        class="h-8 px-panel-padding flex items-center border-b border-outline-variant bg-surface-container-low"
    >
        <span
            class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant"
        >
            <span class="material-symbols-outlined text-[14px] align-middle mr-1"
                >queue_music</span
            >
            Playlist
        </span>
    </div>
    <div class="flex-1 overflow-y-auto bg-surface-dim flex flex-col">
        <!-- El JS renderiza los items aquí -->
        <div data-playlist-items class="flex flex-col flex-1">
            <div
                class="flex-1 flex items-center justify-center p-4 text-center font-label-md text-label-md text-on-surface-variant opacity-40 italic"
            >
                La playlist está vacía
            </div>
        </div>
        <!-- Footer -->
        <div
            class="px-panel-padding py-1 border-t border-outline-variant bg-surface/50 flex justify-between items-center flex-shrink-0"
        >
            <span
                data-playlist-count
                class="font-label-md text-label-md text-on-surface-variant">0 items</span
            >
            <span
                data-playlist-duration
                class="font-label-md text-label-md text-on-surface-variant">00:00</span
            >
        </div>
    </div>
</aside>
