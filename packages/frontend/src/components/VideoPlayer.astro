---
interface Props {
    currentTitle?: string;
}

const { currentTitle = "Sin video" } = Astro.props;
---

<section class="video-panel flex flex-col flex-1 bg-surface-dim relative">
    <div
        class="h-8 px-panel-padding flex items-center justify-between border-b border-outline-variant bg-surface-container-low flex-shrink-0"
    >
        <div
            class="flex items-center gap-2 overflow-hidden whitespace-nowrap text-ellipsis"
        >
            <span
                class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant"
                >Currently Playing:</span
            >
            <span
                data-current-title
                class="font-label-md text-label-md text-on-surface truncate"
                >{currentTitle}</span
            >
        </div>
        <div class="flex items-center gap-1 text-on-surface-variant">
            <span data-player-expand  class="material-symbols-outlined text-[16px] cursor-pointer hover:text-on-surface"
                >add</span
            >
            <span data-player-shrink class="material-symbols-outlined text-[16px] cursor-pointer hover:text-on-surface"
                >remove</span
            >
        </div>
    </div>

    <div
        class="flex-1 relative bg-black flex items-center justify-center overflow-hidden"
    >
        <div id="yt-player" class="absolute inset-0 w-full h-full"></div>
    </div>

    <div
        class="p-panel-padding border-t border-outline-variant bg-surface-container flex-shrink-0 space-y-3"
    >
        <div class="flex justify-between items-center">
            <div class="flex items-center gap-1">
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Add to Playlist"
                >
                    <span class="material-symbols-outlined text-[18px]">add</span>
                </button>
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Search"
                >
                    <span class="material-symbols-outlined text-[18px]">search</span>
                </button>
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Playlist List"
                >
                    <span class="material-symbols-outlined text-[18px]"
                        >format_list_bulleted</span
                    >
                </button>
                <button
                    data-sync-status
                    class="bg-secondary/20 border border-secondary p-1.5 rounded text-secondary transition-colors"
                    title="Sync Status: Connected"
                >
                    <span class="material-symbols-outlined text-[18px]">check</span>
                </button>
            </div>
            <div class="flex items-center gap-1">
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Refresh Sync"
                >
                    <span class="material-symbols-outlined text-[18px]">sync</span>
                </button>
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Fullscreen"
                >
                    <span class="material-symbols-outlined text-[18px]"
                        >fullscreen</span
                    >
                </button>
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Copy Link"
                >
                    <span class="material-symbols-outlined text-[18px]">link</span>
                </button>
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Next Video"
                >
                    <span class="material-symbols-outlined text-[18px]"
                        >skip_next</span
                    >
                </button>
            </div>
        </div>

        <slot />
    </div>
</section>
