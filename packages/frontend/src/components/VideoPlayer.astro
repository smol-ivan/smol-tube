---
interface Props {
    currentTitle?: string;
}

const { currentTitle = "None" } = Astro.props;

import { Icon } from "astro-icon/components";
---

<section class="video-panel flex flex-col flex-1 bg-surface-dim relative">
    <div
        class="h-8 px-panel-padding flex items-center justify-between border-b border-outline-variant bg-surface-container-low flex-shrink-0"
    >
        <div
            class="flex items-center gap-2 overflow-hidden whitespace-nowrap text-ellipsis"
        >
            <span
                class="font-label-sm text-label-sm uppercase tracking-widest text-on-surface-variant"
                >Currently Playing:</span
            >
            <span
                data-current-title
                class="font-label-md text-label-md text-on-surface truncate"
                >{currentTitle}</span
            >
        </div>
        <div class="flex items-center gap-1 text-on-surface-variant">
            <Icon
                name="lucide:plus"
                data-player-expand
                class="size-4 cursor-pointer hover:text-on-surface"
            />
            <Icon
                name="lucide:minus"
                data-player-shrink
                class="size-4 cursor-pointer hover:text-on-surface"
            />
        </div>
    </div>

    <div
        class="w-full bg-black flex items-center justify-center overflow-hidden"
    >
        <div id="yt-player" class="w-full aspect-video max-h-[45vh]"></div>
    </div>

    <div
        class="p-panel-padding border-t border-outline-variant bg-surface-container flex-shrink-0 space-y-3"
    >
        <div class="flex justify-between items-center">
            <div class="flex items-center gap-1">
                <button
                    data-sync-status
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded text-on-surface-variant hover:bg-surface-container-highest hover:text-on-surface transition-colors cursor-pointer"
                    title="Without a leader - click to take control"
                >
                    <!-- Mantenemos el componente para el servidor, pero el JS lo actualizará -->
                    <Icon name="lucide:star-off" class="size-4" />
                </button>
            </div>
            <div class="flex items-center gap-1">
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Refresh Sync"
                >
                    <Icon name="lucide:cloud-sync" class="size-4" />
                </button>
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Fullscreen"
                >
                    <Icon name="lucide:fullscreen" class="size-4" />
                </button>
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Copy Link"
                >
                    <Icon name="lucide:link-2" class="size-4" />
                </button>
                <button
                    class="bg-surface-variant border border-outline-variant p-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface"
                    title="Next Video"
                >
                    <Icon name="lucide:skip-forward" class="size-4" />
                </button>
                <button
                    data-vote-skip
                    class="bg-surface-variant border border-outline-variant px-1.5 py-1.5 rounded hover:bg-surface-container-highest transition-colors text-on-surface font-label-md text-label-md flex items-center gap-1"
                    title="Vote to skip current video"
                >
                    <Icon name="lucide:vote" class="size-4" />
                    Vote Skip (<span id="skip-votes-count">0</span>)
                </button>
            </div>
        </div>

        <slot />
    </div>
</section>
