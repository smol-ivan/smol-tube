---
import Layout from "../layouts/Layout.astro";
import TopAppBar from "../components/TopAppBar.astro";
import UsersPanel from "../components/UsersPanel.astro";
import ChatPanel from "../components/ChatPanel.astro";
import VideoPlayer from "../components/VideoPlayer.astro";
import MediaQueueForm from "../components/MediaQueueForm.astro";
import PlaylistPanel from "../components/PlaylistPanel.astro";
---

<Layout title="SMOL-TUBE">
    <TopAppBar appName="SYNC-INDUSTRIAL" connectedLabel="CYTUBE_MAIN" />

    <main class="dashboard-grid">
        <aside
            class="chat-panel border-r border-outline-variant bg-surface flex flex-col h-full"
        >
            <UsersPanel userCount={1} currentUser="smol-test" />
            <ChatPanel
                currentUser="smol-test"
                chatMessage="sync check"
                systemMessage="Video synchronization enabled."
            />
        </aside>

        <div class="flex flex-col h-full overflow-hidden">
            <VideoPlayer
                currentTitle="[PV] Let Me Hear/Fear, and Loathing in Las Vegas"
                previewImageUrl="https://lh3.googleusercontent.com/aida-public/AB6AXuAQR2j7oFq2gjSbOjrc7wmVlqZzPcx2wnQmjjIsiLDtVgTfDGZ84Ug-wedlwulWR8hhWShyCEDGT90S0RTxkPoYsSDe_XyyxZSFe0kFx9Alck4WvHfQsfsHfFox8LUG5DWyOSlqv3nVJ9_5G3GRVsN2TQ7Wbx08nhzSiN0Ga5k3hOG0yYmeUzxekogvu4-YVHEId9VeTj1Ew9wl8LHpFu0hxVPYkgbM2oW7eqL3jNrh5SRNn0vD6J6GcB0RWPAoLMeb9Nf0dQIcbTdp"
                subtitleText="absolutely"
            >
                <MediaQueueForm
                    mediaPlaceholder="Media URL"
                    temporaryFieldId="temp-add"
                    temporaryLabel="Add as temporary"
                />
            </VideoPlayer>

            <PlaylistPanel
                itemTitle="[PV] Let Me Hear/Fear, and Loathing in Las Vegas"
                itemDuration="03:55"
                totalItemsLabel="1 item"
                totalDuration="03:55"
            />
        </div>
    </main>
</Layout>
