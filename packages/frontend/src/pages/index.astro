---
import Layout from "../layouts/Layout.astro";
import TopAppBar from "../components/TopAppBar.astro";
import UsersPanel from "../components/UsersPanel.astro";
import ChatPanel from "../components/ChatPanel.astro";
import VideoPlayer from "../components/VideoPlayer.astro";
import MediaQueueForm from "../components/MediaQueueForm.astro";
import PlaylistPanel from "../components/PlaylistPanel.astro";
import LoginModal from "../components/LoginModal.astro";
---

<Layout title="smol-tube">
    <LoginModal />
    <TopAppBar appName="smol-tube" />

    <main class="dashboard-grid">
        <aside
            class="chat-panel border-r border-outline-variant bg-surface flex flex-col h-full"
        >
            <UsersPanel />
            <ChatPanel />
        </aside>

        <div class="flex flex-col h-full overflow-hidden">
            <VideoPlayer>
                <MediaQueueForm
                    mediaPlaceholder="URL o ID de YouTube"
                    temporaryFieldId="temp-add"
                    temporaryLabel="Agregar como temporal"
                />
            </VideoPlayer>

            <PlaylistPanel />
        </div>
    </main>

    <script src="../scripts/index.ts"></script>
</Layout>
